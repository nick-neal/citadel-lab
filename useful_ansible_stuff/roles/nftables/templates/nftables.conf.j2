#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Router firewall - generated by the nftables role. Edit the inventory
# (nftables_zones, nftables_input_rules, ...), not these files.
#
# Zones:
{% for z in nftables_zones %}
#   {{ '%-8s' | format(z.interface) }} {{ '%-8s' | format(z.name) }} {{ 'inside ' if z.inside | default(false) else 'outside' }}  {{ z.networks | join(', ') }}
{% endfor %}
#
# A new forwarded connection runs from_<source zone>, then to_<dest zone>:
#   - from_* chains DROP, or RETURN to pass the packet on (never accept)
#   - to_* chains ACCEPT what is allowed in; the rest hits the forward policy

flush ruleset

include "{{ nftables__dir }}/defines.nft"
{% for z in nftables_zones %}
include "{{ nftables__dir }}/zones/from_{{ z.name }}.nft"
include "{{ nftables__dir }}/zones/to_{{ z.name }}.nft"
{% endfor %}

table inet filter {

    # Traffic addressed to the router itself
    chain input {
        type filter hook input priority filter; policy drop;

        ct state invalid drop
        ct state established,related accept
        iif lo accept

{% for rule in nftables_input_rules %}
        {{ rule }}
{% endfor %}

        limit rate {{ nftables_log_limit }} log prefix "nft input drop: "
    }

    # Traffic routed through the router
    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state invalid drop
        ct state established,related accept

        # 1) source zone checks
        iifname vmap {
{% for z in nftables_zones %}
            ${{ z.name | upper }}_IF : jump from_{{ z.name }}{{ ',' if not loop.last }}
{% endfor %}
        }

        # 2) destination zone allow rules
        oifname vmap {
{% for z in nftables_zones %}
            ${{ z.name | upper }}_IF : jump to_{{ z.name }}{{ ',' if not loop.last }}
{% endfor %}
        }

        limit rate {{ nftables_log_limit }} log prefix "nft forward drop: "
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

include "{{ nftables__dir }}/nat.nft"
