{% from 'netmask.j2' import netmask, network %}
# {{ ansible_managed }}
#
# OpenVPN server - generated by the openvpn_server role.
# Service:  systemctl status openvpn-server@server
# Logs:     journalctl -u openvpn-server@server

port {{ openvpn_server_port }}
proto {{ openvpn_server_proto }}
dev {{ openvpn_server_dev }}
topology subnet

# Tunnel pool; the server takes the first address
server {{ network(openvpn_server_network) }} {{ netmask(openvpn_server_network) }}

# ---- certificates and keys ----
ca         /etc/openvpn/server/ca.crt
cert       /etc/openvpn/server/server.crt
key        /etc/openvpn/server/server.key
tls-crypt  /etc/openvpn/server/tls-crypt.key
dh         none
crl-verify /etc/openvpn/server/crl.pem

tls-version-min {{ openvpn_server_tls_version_min }}
data-ciphers {{ openvpn_server_data_ciphers }}
remote-cert-tls client

# ---- pushed to clients ----
{% for route in openvpn_server_push_routes %}
push "route {{ network(route) }} {{ netmask(route) }}"
{% endfor %}
{% for dns in openvpn_server_dns %}
push "dhcp-option DNS {{ dns }}"
{% endfor %}
{% if openvpn_server_domain %}
push "dhcp-option DOMAIN {{ openvpn_server_domain }}"
{% endif %}
{% if openvpn_server_redirect_gateway %}
push "redirect-gateway def1 bypass-dhcp"
push "block-outside-dns"
{% endif %}

# Fixed client addresses (from openvpn_server_clients[].ip)
client-config-dir /etc/openvpn/server/ccd
{% if openvpn_server_client_to_client %}

# OpenVPN switches client <-> client traffic itself; the firewall never sees it
client-to-client
{% endif %}

keepalive 10 60
persist-key
persist-tun
user {{ openvpn_server_run_user }}
group {{ openvpn_server_run_group }}
explicit-exit-notify {{ 1 if openvpn_server_proto == 'udp' else 0 }}
verb 3
