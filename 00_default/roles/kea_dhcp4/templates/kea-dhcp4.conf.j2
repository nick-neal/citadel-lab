// {{ ansible_managed }}
{
    "Dhcp4": {
        "interfaces-config": {
            "interfaces": {{ kea_dhcp4_interfaces | to_json }},
            "dhcp-socket-type": "raw"
        },

        "lease-database": {
            "type": "memfile",
            "persist": true,
            "lfc-interval": {{ kea_dhcp4_lfc_interval }}
        },

        "valid-lifetime": {{ kea_dhcp4_valid_lifetime }},
        "renew-timer": {{ kea_dhcp4_renew_timer }},
        "rebind-timer": {{ kea_dhcp4_rebind_timer }},

        "option-data": {{ kea_dhcp4_option_data | to_nice_json(indent=4) | indent(8) }},

        "subnet4": {{ kea_dhcp4_subnets | to_nice_json(indent=4) | indent(8) }},

        "loggers": [
            {
                "name": "kea-dhcp4",
                "output_options": [ { "output": "syslog" } ],
                "severity": "{{ kea_dhcp4_log_severity }}"
            }
        ]
    }
}