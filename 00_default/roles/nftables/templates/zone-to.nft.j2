# {{ ansible_managed }}
#
# to_{{ nftables__zone.name }}: what may ENTER {{ nftables__zone.name }} ({{ nftables__zone.interface }})
# Rules: nftables_zones[{{ nftables__zone.name }}].to_rules in the inventory.
# Runs after the source zone's from_* chain. "accept" here lets it through.

table inet filter {
    chain to_{{ nftables__zone.name }} {
{% for rule in nftables__zone.to_rules | default([]) %}
        {{ rule }}
{% endfor %}
{% if nftables__zone.to_rules | default([]) | length > 0 %}

{% endif %}
{% if nftables__zone.to_policy | default('open') == 'locked' %}
        # policy: LOCKED - only traffic accepted above gets through
        limit rate {{ nftables_log_limit }} log prefix "to_{{ nftables__zone.name }} drop: "
        drop
{% else %}
        # policy: OPEN - anything from an inside zone
        iifname $INSIDE_IFS accept
{% endif %}
    }
}
