# {{ ansible_managed }}
#
# NAT: inside networks masquerade out the nftables_masquerade_zone interface;
# port forwards come from nftables_port_forwards. Inside <-> inside traffic is
# routed, not NATed.

table ip nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
{% for pf in nftables_port_forwards %}
        iifname ${{ (pf.zone | default(nftables_masquerade_zone)) | upper }}_IF {{ pf.proto | default('tcp') }} dport {{ pf.port }} dnat to {{ pf.to }}{{ (':' ~ pf.to_port) if pf.to_port is defined else '' }}
{% endfor %}
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
{% if nftables_masquerade_zone %}
        oifname ${{ nftables_masquerade_zone | upper }}_IF ip saddr $INSIDE_NETS masquerade
{% endif %}
    }
}
